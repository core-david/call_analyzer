# Deepgram
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_REQUEST_TIMEOUT=600     # seconds before a transcription is a retryable timeout
DEEPGRAM_MAX_CONCURRENCY=5       # concurrent Deepgram requests per worker (PAYG quota is 50)

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
LLM_MAX_CONCURRENCY=5            # concurrent LLM requests per worker (used in M3)

# Postgres (local defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/call_analyzer

# Redis (local defaults)
REDIS_URL=redis://localhost:6379

# Object storage — the app reads ONLY these STORAGE_* vars (S3 protocol).
# Local dev points them at MinIO; prod / real-transcription points them at R2.
# Switching between MinIO and R2 is purely a matter of these five values.
STORAGE_ENDPOINT_URL=http://localhost:9000     # MinIO local; R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=minioadmin                  # MinIO local; R2: the API token's Access Key ID
STORAGE_SECRET_KEY=minioadmin                  # MinIO local; R2: the API token's Secret Access Key
STORAGE_BUCKET_NAME=call-analyzer-audio        # R2: your bucket name
STORAGE_REGION=auto                            # R2 wants "auto"; MinIO ignores it

# Cloudflare R2 reference (not read by the app) — create an R2 API token at
# R2 overview -> Manage API Tokens (Object Read & Write), then copy its
# Access Key ID / Secret into the STORAGE_* vars above to use R2.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
